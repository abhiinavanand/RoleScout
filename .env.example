NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://rolescout:rolescout@localhost:5432/rolescout?schema=public
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-a-long-random-development-secret
CLIENT_URL=http://localhost:5173
RESUME_STORAGE_PATH=./storage/resumes
MAX_RESUME_SIZE_BYTES=10485760
# Optional. Resume parsing uses a deterministic fallback when omitted.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JOB_SEARCH_API_KEY=
JOB_SEARCH_PROVIDER=serpapi
WORKER_CONCURRENCY=2
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20
SHUTDOWN_TIMEOUT_MS=10000
